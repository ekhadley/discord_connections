[Unit]
Description=Discord Connections Activity backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ek/wgmn/discord_connections/backend
EnvironmentFile=/home/ek/wgmn/discord_connections/backend/.env
ExecStart=/home/ek/wgmn/discord_connections/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --ws websockets
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
